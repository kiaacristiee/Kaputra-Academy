datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String
  phone         String?
  role          String    @default("STUDENT")
  studentIdStr  String?   @unique // e.g., KPA-2026-0001
  parentId      String?   
  isActive      Boolean   @default(false)
  isDisabled    Boolean   @default(false) // For admin disable/enable feature
  acceptedTerms Boolean   @default(false) // For terms & conditions requirement
  dateOfBirth   DateTime?
  activationToken String?  @unique
  activationExpires DateTime?
  resetToken      String?  @unique
  resetTokenExpires DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  parent              User?               @relation("ParentChild", fields: [parentId], references: [id])
  children            User[]              @relation("ParentChild")
  enrollments         Enrollment[]
  teachingAssignments TeacherAssignment[]
  verifiedPayments    Payment[]           @relation("PaymentVerifier")
  invoices            Invoice[]
  verifiedInvoices    PaymentVerification[] @relation("InvoiceVerifier")

  // New Dashboard Relations
  mockSubmissions     MockSubmission[]    @relation("MockStudent")
  academicReports     AcademicReport[]    @relation("ReportStudent")
  attendanceRecords   Attendance[]        @relation("AttendanceStudent")
  markedAttendances   Attendance[]        @relation("AttendanceMarker")
  teacherSchedules    Schedule[]          @relation("ScheduleTeacher")
  studentSchedules    Schedule[]          @relation("ScheduleStudent")
  privateTeacherSessions PrivateSession[] @relation("SessionTeacher")
  privateStudentSessions PrivateSession[] @relation("SessionStudent")
  salaries            Salary[]            @relation("SalaryTeacher")
  announcements       Announcement[]      @relation("AnnouncementTeacher")
  announcementReads   AnnouncementRead[]  @relation("AnnouncementReadStudent")
  teacherAttendances  TeacherAttendance[] @relation("TeacherAttendance")
  targetedAnnouncements Announcement[]    @relation("AnnouncementTargets")
  reminders           Reminder[]          @relation("ReminderTeacher")
  campRegistrations   CampRegistration[]
  liveChatSessions    LiveChatSession[]   @relation("ChatUser")
  assignedChats       LiveChatSession[]   @relation("ChatAdmin")

  // Teacher↔Student Assignment Relations
  assignedTeachers    StudentTeacherAssignment[] @relation("StudentTeacherStudent")
  campTeacherSchedules CampSchedule[]           @relation("CampScheduleTeacher")
  assignedStudents    StudentTeacherAssignment[] @relation("StudentTeacherTeacher")
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  courses     Course[]
}

model Course {
  id               String   @id @default(cuid())
  title            String
  slug             String   @unique
  shortDescription String
  fullDescription  String   
  objectives       String   
  learningOutcomes String   
  schedule         String
  price            Float    // Base or "Starting from" price for catalog display
  pricePrivateOnce       Float    @default(0)
  pricePrivateTwice      Float    @default(0)
  priceSemiPrivateOnce   Float    @default(0)
  priceSemiPrivateTwice  Float    @default(0)
  registrationFee  Float    @default(0)
  thumbnailUrl     String?
  categoryId       String
  isPublished      Boolean  @default(false)
  type             String   @default("REGULAR") // "REGULAR" or "COMPETITION"
  settlementAccount String  @default("COMPANY") // "PERSONAL" or "COMPANY"
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  category      Category            @relation(fields: [categoryId], references: [id])
  teachers      TeacherAssignment[]
  registrations Registration[]

  // New Relations
  videos        Video[]
  materials     Material[]
  mockTests     MockTest[]
  academicReports AcademicReport[]
  attendances   Attendance[]
  schedules     Schedule[]
  privateSessions PrivateSession[]
  announcements Announcement[]
  reminders     Reminder[]
}

model TeacherAssignment {
  id         String   @id @default(cuid())
  teacherId  String
  courseId   String
  assignedAt DateTime @default(now())

  teacher User   @relation(fields: [teacherId], references: [id])
  course  Course @relation(fields: [courseId], references: [id])

  @@unique([teacherId, courseId])
}

model StudentTeacherAssignment {
  id         String   @id @default(cuid())
  teacherId  String
  studentId  String
  isPrimary  Boolean  @default(true)
  assignedAt DateTime @default(now())

  teacher User @relation("StudentTeacherTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  student User @relation("StudentTeacherStudent", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([teacherId, studentId])
}

model Registration {
  id                String             @id @default(cuid())
  studentId         String?            // Link to student User
  studentName       String
  studentAge        Int
  parentName        String
  parentPhone       String
  parentEmail       String
  courseId          String
  learningMethod    String?            // "SEMI_PRIVATE" or "PRIVATE"
  sessionsPerWeek   Int?               // 1 or 2
  scheduleId        String?            // Selected private schedule slot id
  grade             String?            // e.g. "GRADE_3" — student grade at registration
  status            String             @default("PENDING_PAYMENT")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  course            Course             @relation(fields: [courseId], references: [id])
  payment           Payment?
  placementTest     PlacementTest?
}

model Payment {
  id                   String        @id @default(cuid())
  registrationId       String        @unique
  amount               Float
  paymentMethod        String?
  receiptUrl           String?       // Support for payment receipt uploads
  status               String        @default("PENDING")
  verifiedById         String?
  verifiedAt           DateTime?
  adminNotes           String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  // Midtrans VA fields
  transactionId        String?
  bank                 String?
  virtualAccountNumber String?
  expiryTime           DateTime?

  registration         Registration  @relation(fields: [registrationId], references: [id])
  verifiedBy           User?         @relation("PaymentVerifier", fields: [verifiedById], references: [id])
}

model PlacementTest {
  id                  String       @id @default(cuid())
  registrationId      String       @unique
  studentIdStr        String       @unique // e.g., KPA-2026-0001
  testCode            String       @unique // e.g., PT-KPA-8X3F9Q
  status              String       @default("NOT_STARTED")
  expiresAt           DateTime?
  startedAt           DateTime?
  submittedAt         DateTime?
  score               Float?
  answers             String?       // JSON for multiple choice answers
  qualificationStatus String?      // "QUALIFIED" or "NOT_QUALIFIED"
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  registration     Registration @relation(fields: [registrationId], references: [id])
}

model Enrollment {
  id         String   @id @default(cuid())
  studentId  String
  itemId     String
  itemType   String
  status     String   @default("ACTIVE")
  enrolledAt DateTime @default(now())

  student    User     @relation(fields: [studentId], references: [id])
}

model Invoice {
  id                   String    @id @default(cuid())
  invoiceNumber        String    @unique
  studentId            String
  itemId               String
  itemType             String
  amount               Float
  virtualAccountNumber String?
  status               String    @default("PENDING") // PENDING, WAITING_VERIFICATION, PAID, REJECTED, EXPIRED, CANCELLED
  approvalStatus       String    @default("APPROVED") // DRAFT_PENDING, APPROVED, REJECTED
  itemCategory         String?   // REGULAR, COMPETITION, CAMP
  learningMethod       String?   // PRIVATE, SEMI_PRIVATE
  sessionsPerWeek      Int?      // 1 or 2
  settlementAccount    String?   // PERSONAL, COMPANY
  receiptUrl           String?
  dueDate              DateTime
  paidAt               DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  // Midtrans VA fields
  orderId              String?   @unique
  transactionId        String?
  bank                 String?   // bca, bni, bri, permata, mandiri
  expiryTime           DateTime?

  student              User      @relation(fields: [studentId], references: [id])
  verifications        PaymentVerification[]
}

model PaymentVerification {
  id              String    @id @default(cuid())
  invoiceId       String
  approvedById    String?
  status          String    @default("PENDING") // APPROVED, REJECTED
  rejectionReason String?
  verifiedAt      DateTime?

  invoice         Invoice   @relation(fields: [invoiceId], references: [id])
  approvedBy      User?     @relation("InvoiceVerifier", fields: [approvedById], references: [id])
}

model ContentBlock {
  id        String   @id @default(cuid())
  section   String   @unique // e.g., "hero_slider", "about_us", "contact_info"
  content   String    // JSON string payload for CMS content
  updatedAt DateTime @updatedAt
}

model TrialContent {
  id          String   @id @default(cuid())
  type        String   // "VIDEO", "MATERIAL", "MOCK_TEST"
  title       String
  url         String?  // file or video link
  description String?  
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Video {
  id            String   @id @default(cuid())
  courseId      String?
  campProgramId String?
  title         String
  videoUrl      String
  category      String?
  order         Int      @default(0)
  isPublished   Boolean  @default(false)
  isTrial       Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  course        Course?      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  campProgram   CampProgram? @relation(fields: [campProgramId], references: [id], onDelete: SetNull)
  quizzes       InteractiveVideoQuiz[]
}

model InteractiveVideoQuiz {
  id             String   @id @default(cuid())
  videoId        String
  timestamp      Int      // Stored in seconds for easy playback comparison
  question       String
  optionA        String
  optionB        String
  optionC        String
  optionD        String
  correctAnswer  String
  explanation    String?
  requireCorrect Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  video          Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
}

model Material {
  id            String       @id @default(cuid())
  courseId      String?
  campProgramId String?
  title         String
  fileUrl       String
  description   String?
  isPublished   Boolean  @default(false)
  isTrial       Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  course        Course?      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  campProgram   CampProgram? @relation(fields: [campProgramId], references: [id], onDelete: SetNull)
}

model MockTest {
  id            String   @id @default(cuid())
  courseId      String?  // Null for general/trial mock tests
  campProgramId String?  // Optional: ties mock test to a Camp Program
  title         String
  timeLimit     Int      // in minutes
  passingScore  Float
  isPublished   Boolean  @default(false)
  isTrial       Boolean  @default(false)
  questionOrder String?  // JSON array string of question IDs e.g. '["id1","id2"]'
  targetedGrade String?  // e.g. "GRADE_5" — targeted student grade level
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  course        Course?      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  campProgram   CampProgram? @relation(fields: [campProgramId], references: [id], onDelete: SetNull)
  questions     MockQuestion[]
  submissions   MockSubmission[]
}

model MockQuestion {
  id           String   @id @default(cuid())
  courseId     String?  // Optional: ties question to a specific course's bank
  folderId     String?
  questionText String   
  options      String   // JSON string of options Array
  correctAnswer String  // the correct answer index or text
  explanation  String?  
  topic        String?
  difficulty   String?
  imageUrl     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  mockTests    MockTest[] // Implicit many-to-many
  folder       QuestionFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
}

model QuestionFolder {
  id        String         @id @default(cuid())
  name      String
  parentId  String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  parent    QuestionFolder?  @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children  QuestionFolder[] @relation("FolderHierarchy")
  questions MockQuestion[]
}

model MockSubmission {
  id                  String   @id @default(cuid())
  mockTestId          String
  studentId           String
  score               Float
  answers             String    // JSON string of student answers
  timeSpent           String?   // JSON string of time spent per question in seconds
  totalCompletionTime Int?      // Overall completion time in seconds
  attemptNumber       Int      @default(1)
  isPassed            Boolean
  submittedAt         DateTime @default(now())

  mockTest    MockTest @relation(fields: [mockTestId], references: [id], onDelete: Cascade)
  student     User     @relation("MockStudent", fields: [studentId], references: [id], onDelete: Cascade)
}

model AcademicReport {
  id                 String   @id @default(cuid())
  studentId          String
  courseId           String
  grade              String
  progress           Int      @default(0)
  teacherNotes       String?  
  skillAssessment    String?  
  completedModules   String?  
  status             String   @default("DRAFT") // DRAFT, SUBMITTED
  performanceSummary String?
  strengths          String?
  improvements       String?
  learningProgress   String?
  nextSteps          String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  student          User     @relation("ReportStudent", fields: [studentId], references: [id], onDelete: Cascade)
  course           Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model PrivateSession {
  id          String   @id @default(cuid())
  teacherId   String
  studentId   String
  courseId    String?  
  date        DateTime
  startTime   String
  endTime     String
  duration    Int?
  status      String   @default("SCHEDULED") // SCHEDULED, COMPLETED, CANCELLED, RESCHEDULED
  attendance  String?  // PRESENT, ABSENT, EXCUSED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  teacher     User     @relation("SessionTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  student     User     @relation("SessionStudent", fields: [studentId], references: [id], onDelete: Cascade)
  course      Course?  @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model Attendance {
  id          String   @id @default(cuid())
  studentId   String
  courseId    String
  date        DateTime
  status      String   // "PRESENT", "LATE", "ABSENT", "EXCUSED"
  notes       String?  
  markedById  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  student     User     @relation("AttendanceStudent", fields: [studentId], references: [id], onDelete: Cascade)
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  markedBy    User?    @relation("AttendanceMarker", fields: [markedById], references: [id])
}

model Schedule {
  id          String   @id @default(cuid())
  courseId    String?  // Null for general availability
  teacherId   String
  studentId   String?  // Null for semi-private or unbooked slots
  dayOfWeek   String   // MONDAY, TUESDAY, etc.
  startTime   String   // e.g. "09:00"
  endTime     String   // e.g. "10:30"
  type        String   // "PRIVATE" or "SEMI_PRIVATE"
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course      Course?  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacher     User     @relation("ScheduleTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  student     User?    @relation("ScheduleStudent", fields: [studentId], references: [id], onDelete: SetNull)
}

model Salary {
  id             String   @id @default(cuid())
  teacherId      String
  month          String   // e.g. "June 2026"
  baseSalary     Float
  bonus          Float    @default(0)
  status         String   @default("PENDING") // PAID, PENDING
  receiptUrl     String?
  paymentDetails String?  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  teacher        User     @relation("SalaryTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
}

model Announcement {
  id             String             @id @default(cuid())
  title          String
  description    String             
  targetAudience String             // "STUDENTS", "PARENTS", "BOTH"
  courseId       String?            // Null for general announcements
  isPublished    Boolean            @default(false)
  publishDate    DateTime           @default(now())
  teacherId      String
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  course         Course?            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacher        User               @relation("AnnouncementTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  reads          AnnouncementRead[]
  targetStudents User[]             @relation("AnnouncementTargets")
}

model AnnouncementRead {
  id             String       @id @default(cuid())
  announcementId String
  studentId      String
  readAt         DateTime     @default(now())

  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  student        User         @relation("AnnouncementReadStudent", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([announcementId, studentId])
}

model TeacherAttendance {
  id           String    @id @default(cuid())
  teacherId    String
  date         DateTime
  checkIn      DateTime?
  checkOut     DateTime?
  status       String    // "PRESENT", "ABSENT", "LATE"
  workingHours Float     @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  teacher      User      @relation("TeacherAttendance", fields: [teacherId], references: [id], onDelete: Cascade)
}

model Reminder {
  id          String   @id @default(cuid())
  title       String
  description String?  
  type        String   // "CLASS_START", "HOMEWORK", "MOCK_TEST", "DEADLINE"
  dueDate     DateTime?
  courseId    String?
  teacherId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course      Course?  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacher     User     @relation("ReminderTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
}

model CampProgram {
  id                   String             @id @default(cuid())
  name                 String
  slug                 String             @unique
  description          String
  learningObjectives   String?
  topicsCovered        String?
  scheduleInfo         String?
  instructor           String?
  duration             String?
  thumbnailUrl         String?
  startDate            DateTime
  endDate              DateTime
  registrationDeadline DateTime
  price                Float
  allow1xWeek          Boolean            @default(true)
  price1xWeek          Float              @default(0)
  allow2xWeek          Boolean            @default(true)
  price2xWeek          Float              @default(0)
  capacity             Int?
  status               String             @default("OPEN") // "OPEN" or "CLOSED"
  visibility           String             @default("DRAFT") // "PUBLISHED" or "DRAFT"
  type                 String             @default("CAMP")
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  registrations        CampRegistration[]
  videos               Video[]
  materials            Material[]
  mockTests            MockTest[]
  schedules            CampSchedule[]
}

model CampSchedule {
  id            String   @id @default(cuid())
  campProgramId String
  dayOfWeek     String   // "FRIDAY" or "SATURDAY"
  startTime     String   // e.g. "15:00"
  endTime       String   // e.g. "16:30"
  className     String   // e.g. "Class A" or "Class B"
  capacity      Int      @default(4)
  teacherId     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  campProgram       CampProgram            @relation(fields: [campProgramId], references: [id], onDelete: Cascade)
  teacher           User?                  @relation("CampScheduleTeacher", fields: [teacherId], references: [id], onDelete: SetNull)
  registrationSlots CampRegistrationSlot[]

  @@unique([campProgramId, dayOfWeek, startTime, className])
}

model CampRegistration {
  id                String                 @id @default(cuid())
  studentId         String
  studentName       String
  studentAge        Int
  parentName        String
  parentPhone       String
  parentEmail       String
  campProgramId     String
  sessionFrequency  String?                // "1x_WEEK" or "2x_WEEK"
  sessionsPerMonth  Int?                   // 4 or 8
  price             Float?
  status            String                 @default("PENDING_PAYMENT") // PENDING_PAYMENT, VERIFYING_PAYMENT, APPROVED
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  campProgram       CampProgram            @relation(fields: [campProgramId], references: [id], onDelete: Cascade)
  student           User                   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  slots             CampRegistrationSlot[]
}

model CampRegistrationSlot {
  id                 String           @id @default(cuid())
  campRegistrationId String
  campScheduleId     String
  createdAt          DateTime         @default(now())

  campRegistration   CampRegistration @relation(fields: [campRegistrationId], references: [id], onDelete: Cascade)
  campSchedule       CampSchedule     @relation(fields: [campScheduleId], references: [id], onDelete: Cascade)

  @@unique([campRegistrationId, campScheduleId])
}

model EmailDraft {
  id          String   @id @default(cuid())
  type        String   // "PLACEMENT_TEST_PAYMENT", "CLASS_PAYMENT", "CAMP_PAYMENT", "PLACEMENT_TEST_RESULT", "ENROLLMENT_CONFIRMATION"
  recipient   String
  subject     String
  bodyHtml    String
  status      String   @default("PENDING_APPROVAL") // "PENDING_APPROVAL", "APPROVED", "REJECTED", "SENT"
  metadata    String?  // JSON string
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model LiveChatSession {
  id              String             @id @default(cuid())
  userId          String?            // If logged in
  guestName       String?            // If guest
  guestEmail      String?            // If guest
  guestPhone      String?            // If guest
  status          String             @default("OPEN") // "OPEN", "IN_PROGRESS", "CLOSED"
  assignedAdminId String?
  assignedAt      DateTime?
  lastReplyAt     DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  user            User?              @relation("ChatUser", fields: [userId], references: [id], onDelete: SetNull)
  assignedAdmin   User?              @relation("ChatAdmin", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  messages        LiveChatMessage[]
}

model LiveChatMessage {
  id         String          @id @default(cuid())
  sessionId  String
  senderType String          // "USER" or "ADMIN"
  content    String
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  session    LiveChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}
